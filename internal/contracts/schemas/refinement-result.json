{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "refinement-result",
  "description": "Output of business, po and requirements (v0.3).",
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "Schema version."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "One or two sentences for the journal and the web."
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "title",
          "rationale"
        ],
        "additionalProperties": false
      },
      "description": "Decisions taken under ambiguity."
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          },
          "blocking": {
            "type": "boolean"
          }
        },
        "required": [
          "title",
          "why",
          "blocking"
        ],
        "additionalProperties": false
      },
      "description": "Gaps found; they become proposals."
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "areas": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "role_hint": {
            "type": "string"
          }
        },
        "required": [
          "issue",
          "title",
          "acceptance"
        ],
        "additionalProperties": false
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "v",
    "summary",
    "issues"
  ],
  "additionalProperties": false
}
