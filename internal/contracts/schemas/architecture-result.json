{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "architecture-result",
  "description": "Output of the architect (v0.3).",
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "Schema version."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "One or two sentences for the journal and the web."
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "title",
          "rationale"
        ],
        "additionalProperties": false
      },
      "description": "Decisions taken under ambiguity."
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          },
          "blocking": {
            "type": "boolean"
          }
        },
        "required": [
          "title",
          "why",
          "blocking"
        ],
        "additionalProperties": false
      },
      "description": "Gaps found; they become proposals."
    },
    "adrs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "title"
        ],
        "additionalProperties": false
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "issue": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "path",
          "issue"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "v",
    "summary"
  ],
  "additionalProperties": false
}
