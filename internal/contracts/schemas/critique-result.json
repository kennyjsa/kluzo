{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "critique-result",
  "description": "Output of the critic (v0.3).",
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "Schema version."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "One or two sentences for the journal and the web."
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "title",
          "rationale"
        ],
        "additionalProperties": false
      },
      "description": "Decisions taken under ambiguity."
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          },
          "blocking": {
            "type": "boolean"
          }
        },
        "required": [
          "title",
          "why",
          "blocking"
        ],
        "additionalProperties": false
      },
      "description": "Gaps found; they become proposals."
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "enum": [
              "blocking",
              "major",
              "minor"
            ]
          },
          "category": {
            "enum": [
              "data",
              "infra",
              "contract",
              "e2e",
              "observability",
              "security",
              "rollout",
              "docs"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "suggestion": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "severity",
          "category",
          "title",
          "suggestion"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "v",
    "summary",
    "findings"
  ],
  "additionalProperties": false
}
