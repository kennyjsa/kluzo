{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "review-result",
  "description": "Output of the reviewer. It carries no verdict: Kluzo derives it (ADR 0023).",
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "Schema version."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "One or two sentences for the journal and the web."
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "title",
          "rationale"
        ],
        "additionalProperties": false
      },
      "description": "Decisions taken under ambiguity."
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          },
          "blocking": {
            "type": "boolean"
          }
        },
        "required": [
          "title",
          "why",
          "blocking"
        ],
        "additionalProperties": false
      },
      "description": "Gaps found; they become proposals."
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC[0-9]+$"
          },
          "met": {
            "type": "boolean"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "path:line or path:Name references."
          }
        },
        "required": [
          "id",
          "met",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "previous": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F[0-9]+$"
          },
          "status": {
            "enum": [
              "resolved",
              "open"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "status",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "enum": [
              "blocking",
              "major",
              "minor"
            ]
          },
          "category": {
            "enum": [
              "correctness",
              "tests",
              "security",
              "duplication",
              "dead_code",
              "style",
              "scope"
            ]
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "check": {
            "type": "string",
            "description": "Concrete verification that would close the finding; required for blocking and major."
          },
          "caused_by": {
            "type": [
              "string",
              "null"
            ],
            "description": "path:line changed in the round that caused the finding."
          }
        },
        "required": [
          "severity",
          "category",
          "file",
          "line",
          "message"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "severity": {
                  "enum": [
                    "blocking",
                    "major"
                  ]
                }
              },
              "required": [
                "severity"
              ]
            },
            "then": {
              "required": [
                "check"
              ],
              "properties": {
                "check": {
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "v",
    "summary",
    "criteria",
    "findings"
  ],
  "additionalProperties": false
}
